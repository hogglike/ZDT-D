<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_network_background">

    <LinearLayout android:id="@+id/health_root" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/health_time" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#BCCFC9" />
        <TextView android:id="@+id/health_results" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#F2FAF7" />
    </LinearLayout>
    <TextView android:id="@+id/health_check" android:layout_width="match_parent"
        android:layout_height="42dp" android:gravity="center" android:text="Проверить связь"
        android:textColor="#A9F2D7" android:textStyle="bold" />
    <TextView android:id="@+id/mode_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
        android:text="VPN выключен" android:textColor="#F2FAF7" android:textSize="14sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/mode_white" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center" android:text="Белый"
            android:textColor="#F2FAF7" android:textSize="13sp" android:textStyle="bold"
            android:background="#22413A" />
        <TextView android:id="@+id/mode_normal" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginStart="4dp" android:gravity="center" android:text="Обычный"
            android:textColor="#F2FAF7" android:textSize="13sp" android:textStyle="bold"
            android:background="#22413A" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/mode_normal2" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1"
            android:gravity="center" android:text="Обычный 2"
            android:textColor="#F2FAF7" android:textSize="13sp" android:textStyle="bold"
            android:background="#22413A" />
        <TextView android:id="@+id/mode_browser" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginStart="4dp" android:gravity="center" android:text="Браузер"
            android:textColor="#F2FAF7" android:textSize="13sp" android:textStyle="bold"
            android:background="#22413A" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/mode_server" android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1" android:gravity="center" android:text="Сервер"
            android:textColor="#A9F2D7" android:textSize="13sp" />
        <TextView android:id="@+id/mode_settings" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:gravity="center"
            android:text="Настройки" android:textColor="#A9F2D7" android:textSize="13sp" />
        <TextView android:id="@+id/mode_stop" android:layout_width="0dp"
            android:layout_height="48dp" android:layout_weight="1" android:gravity="center"
            android:text="Отключить" android:textColor="#A9F2D7" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
