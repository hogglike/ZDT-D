{
  "log": {"level": "info", "timestamp": true},
  "dns": {
    "servers": [
      {"type": "udp", "tag": "bootstrap", "server": "1.1.1.1"},
      {
        "type": "https", "tag": "xbox", "server": "xbox-dns.ru",
        "server_port": 443, "path": "/dns-query",
        "domain_resolver": {"server": "bootstrap", "strategy": "ipv4_only"},
        "tls": {"enabled": true, "server_name": "xbox-dns.ru"},
        "connect_timeout": "7s"
      },
      {"type": "hosts", "tag": "marker", "predefined": {"zdtd-profile.invalid": ["192.0.2.123"]}}
    ],
    "rules": [{"domain": ["zdtd-profile.invalid"], "server": "marker"}],
    "final": "xbox", "strategy": "ipv4_only", "independent_cache": true
  },
  "inbounds": [{
    "type": "tun", "tag": "dns-profile-tun", "interface_name": "zdt_dns_one",
    "address": ["10.253.241.1/30"], "mtu": 1400,
    "auto_route": false, "auto_redirect": false, "strict_route": false, "stack": "mixed"
  }],
  "outbounds": [{"type": "direct", "tag": "direct"}],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {"server": "xbox", "strategy": "ipv4_only"},
    "rules": [{"port": [53], "action": "hijack-dns"}],
    "final": "direct"
  }
}
